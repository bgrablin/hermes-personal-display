{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes/display/persona-packet.schema.json",
  "title": "Hermes Personal Display State and Persona Packet",
  "description": "Data contract between Hermes display state collectors, personality engine, and renderer.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/combined_feed" },
    { "$ref": "#/$defs/display_state" },
    { "$ref": "#/$defs/persona_packet" }
  ],
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "boundary": {
      "type": "string",
      "enum": ["local_trusted_display", "trusted_lan", "external_redacted"]
    },
    "service_state": {
      "type": "string",
      "enum": ["ok", "busy", "degraded", "failed", "blocked", "unknown", "stale"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "success", "warning", "critical"]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "display_safe", "private_local", "redacted_only", "forbidden"]
    },
    "redaction_level": {
      "type": "string",
      "enum": ["public", "display_safe", "private_local", "redacted", "blocked"]
    },
    "mood": {
      "type": "string",
      "enum": [
        "idle_watchful",
        "thinking_focused",
        "speaking_waveform",
        "working_autonomous",
        "healthy_smug",
        "degraded_skeptical",
        "attention_needed",
        "blocked_annoyed",
        "night_sleepy",
        "offline_fallback"
      ]
    },
    "skin": {
      "type": "string",
      "enum": ["retro-robot-core", "retro-hermes-accent", "retro-terminal-focus", "retro-night-watch", "retro-amber-watch"]
    },
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "service_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "label", "severity"],
      "properties": {
        "state": { "$ref": "#/$defs/service_state" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "severity": { "$ref": "#/$defs/severity" },
        "last_change": { "$ref": "#/$defs/date_time" },
        "detail": { "type": "string", "maxLength": 160 }
      }
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "kind", "sensitivity"],
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": {
          "type": "string",
          "enum": ["system", "kanban", "cron", "gateway", "home", "calendar", "message", "weather", "other"]
        },
        "sensitivity": { "$ref": "#/$defs/sensitivity" },
        "allowed_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundary" },
          "minItems": 1,
          "uniqueItems": true
        },
        "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "recent_persona_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mood", "skin", "caption", "micro_actions", "at"],
      "properties": {
        "mood": { "$ref": "#/$defs/mood" },
        "skin": { "$ref": "#/$defs/skin" },
        "caption": { "type": "string", "maxLength": 80 },
        "micro_actions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 },
          "maxItems": 8
        },
        "at": { "$ref": "#/$defs/date_time" }
      }
    },
    "display_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at",
        "source",
        "boundary",
        "mode",
        "overall_status",
        "status_summary",
        "services",
        "activity",
        "system",
        "display_policy",
        "recent_persona"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "generated_at": { "$ref": "#/$defs/date_time" },
        "source": { "type": "string", "minLength": 1, "maxLength": 80 },
        "boundary": { "$ref": "#/$defs/boundary" },
        "mode": {
          "type": "string",
          "enum": ["day", "evening", "night", "quiet", "focus", "maintenance"]
        },
        "overall_status": {
          "type": "string",
          "enum": ["healthy", "busy", "degraded", "attention_needed", "blocked", "offline"]
        },
        "status_summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "services": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/service_entry" },
          "minProperties": 1
        },
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active_sessions",
            "active_tools",
            "active_workers",
            "cron_running",
            "cron_failed_recent",
            "kanban_ready",
            "kanban_running",
            "kanban_blocked"
          ],
          "properties": {
            "active_sessions": { "type": "integer", "minimum": 0 },
            "active_tools": { "type": "integer", "minimum": 0 },
            "active_workers": { "type": "integer", "minimum": 0 },
            "cron_running": { "type": "integer", "minimum": 0 },
            "cron_failed_recent": { "type": "integer", "minimum": 0 },
            "kanban_ready": { "type": "integer", "minimum": 0 },
            "kanban_running": { "type": "integer", "minimum": 0 },
            "kanban_blocked": { "type": "integer", "minimum": 0 },
            "last_gateway_event": { "$ref": "#/$defs/date_time" },
            "display_safe_title": { "type": "string", "maxLength": 80 }
          }
        },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "cpu_band", "memory_band", "disk_band", "network_band"],
          "properties": {
            "host": { "type": "string", "minLength": 1, "maxLength": 80 },
            "cpu_band": { "type": "string", "enum": ["low", "moderate", "high", "critical", "unknown"] },
            "memory_band": { "type": "string", "enum": ["low", "moderate", "high", "critical", "unknown"] },
            "disk_band": { "type": "string", "enum": ["low", "moderate", "high", "critical", "unknown"] },
            "network_band": { "type": "string", "enum": ["quiet", "normal", "busy", "degraded", "unknown"] },
            "temperature_band": { "type": "string", "enum": ["cool", "normal", "warm", "hot", "unknown"] }
          }
        },
        "display_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow_local_snippets", "allow_external_model_context", "redaction_required", "forbid_credentials"],
          "properties": {
            "allow_local_snippets": { "type": "boolean" },
            "allow_external_model_context": { "type": "boolean" },
            "redaction_required": { "type": "boolean" },
            "forbid_credentials": { "type": "boolean", "const": true },
            "approved_external_routes": {
              "type": "array",
              "items": { "type": "string", "maxLength": 80 },
              "uniqueItems": true
            }
          }
        },
        "snippets": {
          "type": "array",
          "items": { "$ref": "#/$defs/snippet" },
          "maxItems": 8
        },
        "attention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "needs_human": { "type": "boolean" },
            "reason": { "type": "string", "maxLength": 120 },
            "count": { "type": "integer", "minimum": 0 },
            "severity": { "$ref": "#/$defs/severity" }
          }
        },
        "recent_persona": {
          "type": "array",
          "items": { "$ref": "#/$defs/recent_persona_entry" },
          "maxItems": 20
        }
      }
    },
    "eyes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "gaze", "blink_rate", "pupil", "intensity"],
      "properties": {
        "expression": {
          "type": "string",
          "enum": ["relaxed", "focused", "wide", "squint", "side_eye", "half_lidded", "sleepy", "smug", "offline_blink"]
        },
        "gaze": {
          "type": "string",
          "enum": ["center", "left", "right", "up", "down", "wander", "track_activity"]
        },
        "blink_rate": {
          "type": "string",
          "enum": ["rare", "slow", "normal", "fast", "staccato"]
        },
        "pupil": {
          "type": "string",
          "enum": ["soft", "pinpoint", "scanline", "waveform", "spark", "dim"]
        },
        "intensity": { "$ref": "#/$defs/unit_interval" }
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pose", "tilt", "motion", "orbit", "scale"],
      "properties": {
        "pose": {
          "type": "string",
          "enum": ["hover_center", "lean_left", "lean_right", "upright_alert", "slumped_annoyed", "sleepy_drift", "diagnostic_still"]
        },
        "tilt": { "type": "string", "enum": ["none", "left_small", "right_small", "forward", "back"] },
        "motion": {
          "type": "string",
          "enum": ["breathing", "focused_pulse", "waveform_pulse", "work_spark", "impatient_bounce", "slow_drift", "diagnostic_blink"]
        },
        "orbit": { "type": "string", "enum": ["lazy", "focused", "fast", "clustered", "crossed", "dim", "paused"] },
        "scale": { "type": "number", "minimum": 0.75, "maximum": 1.25 }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "background", "primary", "secondary", "accent", "danger", "brightness"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["cyan-violet-low", "graphite-teal", "phosphor-green", "amber-skeptic", "magenta-alert", "night-ember", "offline-mono"]
        },
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "secondary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "danger": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "brightness": { "type": "number", "minimum": 0.05, "maximum": 1 }
      }
    },
    "micro_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "weight", "cooldown_seconds"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "blink_single",
            "blink_double",
            "eye_track_left",
            "eye_track_right",
            "mote_reorder",
            "ring_pulse",
            "tool_glyph_spark",
            "gateway_wave",
            "speech_waveform",
            "side_eye_hold",
            "impatient_bounce",
            "glyph_arms_cross",
            "approval_stare",
            "dramatic_sigh_wave",
            "smug_nod",
            "sleepy_yawn_wave",
            "diagnostic_scan",
            "offline_blink"
          ]
        },
        "weight": { "$ref": "#/$defs/unit_interval" },
        "cooldown_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "params": { "type": "object", "additionalProperties": true }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tone", "priority", "max_width_chars"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tone": {
          "type": "string",
          "enum": ["calm", "dry", "wry", "playful", "focused", "skeptical", "annoyed", "sleepy", "urgent"]
        },
        "priority": { "type": "string", "enum": ["ambient", "status", "attention", "blocked", "failure"] },
        "max_width_chars": { "type": "integer", "minimum": 12, "maximum": 80 }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_seconds", "transition_ms", "min_hold_seconds", "max_hold_seconds"],
      "properties": {
        "packet_seconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "transition_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "min_hold_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_hold_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "avoid_repeating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captions", "micro_actions", "skins", "moods", "window_seconds"],
      "properties": {
        "captions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 80 },
          "maxItems": 12
        },
        "micro_actions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 },
          "maxItems": 12
        },
        "skins": {
          "type": "array",
          "items": { "$ref": "#/$defs/skin" },
          "maxItems": 5
        },
        "moods": {
          "type": "array",
          "items": { "$ref": "#/$defs/mood" },
          "maxItems": 10
        },
        "window_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "redaction_level", "contains_credentials", "external_model_safe"],
      "properties": {
        "boundary": { "$ref": "#/$defs/boundary" },
        "redaction_level": { "$ref": "#/$defs/redaction_level" },
        "contains_credentials": { "type": "boolean", "const": false },
        "external_model_safe": { "type": "boolean" },
        "notes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "maxItems": 8
        }
      }
    },
    "persona_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at",
        "valid_for_seconds",
        "mood",
        "skin",
        "playfulness",
        "energy",
        "focus",
        "curiosity",
        "impatience",
        "eyes",
        "posture",
        "palette",
        "micro_actions",
        "caption",
        "snippet",
        "duration",
        "avoid_repeating",
        "safety"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "generated_at": { "$ref": "#/$defs/date_time" },
        "valid_for_seconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "mood": { "$ref": "#/$defs/mood" },
        "skin": { "$ref": "#/$defs/skin" },
        "playfulness": { "$ref": "#/$defs/unit_interval" },
        "energy": { "$ref": "#/$defs/unit_interval" },
        "focus": { "$ref": "#/$defs/unit_interval" },
        "curiosity": { "$ref": "#/$defs/unit_interval" },
        "impatience": { "$ref": "#/$defs/unit_interval" },
        "eyes": { "$ref": "#/$defs/eyes" },
        "posture": { "$ref": "#/$defs/posture" },
        "palette": { "$ref": "#/$defs/palette" },
        "micro_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/micro_action" },
          "maxItems": 8
        },
        "caption": { "$ref": "#/$defs/caption" },
        "snippet": {
          "anyOf": [
            { "$ref": "#/$defs/snippet" },
            { "type": "null" }
          ]
        },
        "duration": { "$ref": "#/$defs/duration" },
        "avoid_repeating": { "$ref": "#/$defs/avoid_repeating" },
        "safety": { "$ref": "#/$defs/safety" }
      }
    },
    "combined_feed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_at", "display_state", "persona_packet"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "generated_at": { "$ref": "#/$defs/date_time" },
        "display_state": { "$ref": "#/$defs/display_state" },
        "persona_packet": { "$ref": "#/$defs/persona_packet" }
      }
    }
  }
}
