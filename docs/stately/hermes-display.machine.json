{
  "id": "hermesDisplay",
  "type": "parallel",
  "states": {
    "behavior": {
      "initial": "idle_watch",
      "states": {
        "idle_watch": {
          "on": {
            "ASSISTANT_NOTICE": "notice",
            "LISTENING": "listening",
            "REASONING": "reasoning",
            "TOOL_STARTED": "tool_shell",
            "SEARCH_STARTED": "searching",
            "WRITE_STARTED": "writing",
            "WAITING_USER": "waiting_user",
            "BLOCKED": "blocked",
            "DEGRADED": "degraded_offline"
          }
        },
        "notice": {
          "on": {
            "LISTENING": "listening",
            "READING": "reading",
            "REASONING": "reasoning",
            "TOOL_STARTED": "tool_shell",
            "WAITING_USER": "waiting_user",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "listening": {
          "on": {
            "REASONING": "reasoning",
            "WAITING_USER": "waiting_user",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "reading": {
          "on": {
            "REASONING": "reasoning",
            "TOOL_STARTED": "tool_shell",
            "WAITING_USER": "waiting_user",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "reasoning": {
          "on": {
            "TOOL_STARTED": "tool_shell",
            "SEARCH_STARTED": "searching",
            "WRITE_STARTED": "writing",
            "WAITING_USER": "waiting_user",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "tool_shell": {
          "on": {
            "TOOL_FINISHED": "reasoning",
            "SEARCH_STARTED": "searching",
            "WRITE_STARTED": "writing",
            "WAITING_USER": "waiting_user",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "searching": {
          "on": {
            "TOOL_STARTED": "tool_shell",
            "WRITE_STARTED": "writing",
            "WAITING_USER": "waiting_user",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "writing": {
          "on": {
            "TOOL_STARTED": "tool_shell",
            "WAITING_USER": "waiting_user",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "waiting_user": {
          "on": {
            "ASSISTANT_NOTICE": "notice",
            "USER_RESPONDED": "reasoning",
            "RESOLVE": "complete",
            "BLOCKED": "blocked",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "blocked": {
          "on": {
            "USER_RESPONDED": "reasoning",
            "RESOLVE": "complete",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "complete": {
          "on": {
            "ASSISTANT_NOTICE": "notice",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        },
        "degraded_offline": {
          "on": {
            "RECOVERED": "idle_watch",
            "RESET": "idle_watch",
            "DEGRADED": "degraded_offline"
          }
        }
      },
      "on": {
        "SET_IDLE_WATCH": ".idle_watch",
        "SET_NOTICE": ".notice",
        "SET_LISTENING": ".listening",
        "SET_READING": ".reading",
        "SET_REASONING": ".reasoning",
        "SET_TOOL_SHELL": ".tool_shell",
        "SET_SEARCHING": ".searching",
        "SET_WRITING": ".writing",
        "SET_WAITING_USER": ".waiting_user",
        "SET_BLOCKED": ".blocked",
        "SET_COMPLETE": ".complete",
        "SET_DEGRADED_OFFLINE": ".degraded_offline"
      }
    },
    "health": {
      "initial": "nominal",
      "states": {
        "nominal": {
          "on": {
            "HEALTH_DEGRADED": "degraded",
            "HEALTH_CRITICAL": "critical"
          }
        },
        "degraded": {
          "on": {
            "HEALTH_CRITICAL": "critical",
            "HEALTH_RECOVERED": "nominal",
            "HEALTH_NOMINAL": "nominal"
          }
        },
        "critical": {
          "on": {
            "HEALTH_DEGRADED": "degraded",
            "HEALTH_RECOVERED": "nominal",
            "HEALTH_NOMINAL": "nominal"
          }
        }
      }
    },
    "quiet": {
      "initial": "active",
      "states": {
        "active": {
          "on": {
            "QUIET_ON": "quiet",
            "NIGHT_ON": "night"
          }
        },
        "quiet": {
          "on": {
            "QUIET_OFF": "active",
            "NIGHT_ON": "night",
            "ACTIVE": "active"
          }
        },
        "night": {
          "on": {
            "NIGHT_OFF": "active",
            "QUIET_ON": "quiet",
            "ACTIVE": "active"
          }
        }
      }
    },
    "privacy_display": {
      "initial": "normal",
      "states": {
        "normal": {
          "on": {
            "PRIVACY_SENSITIVE": "sensitive"
          }
        },
        "sensitive": {
          "on": {
            "PRIVACY_CLEAR": "normal"
          }
        }
      }
    }
  }
}
