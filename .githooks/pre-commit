#!/usr/bin/env bash
set -euo pipefail

# Keep docs/current-dashboard.png current when frontend/kiosk code changes.
# This is intentionally a pre-commit hook so the refreshed screenshot is part of
# the same commit that changed the frontend, instead of creating a follow-up
# screenshot-only commit.

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if [[ "${HERMES_SKIP_DASHBOARD_CAPTURE:-}" == "1" ]]; then
  exit 0
fi

changed="$(git diff --cached --name-only --diff-filter=ACMRT)"
if [[ -z "$changed" ]]; then
  exit 0
fi

if ! printf '%s\n' "$changed" | grep -Eq '^(src/|public/|package(-lock)?\.json$|vite\.config\.[cm]?js$|playwright\.config\.[cm]?js$|tests/e2e/|scripts/xsession-minix-kiosk\.sh$|scripts/hermes_display_server\.py$|scripts/generate-build-id\.js$)'; then
  exit 0
fi

echo "Build-id hook: frontend change detected; refreshing generated build/cache key"
npm run generate:build-id >/dev/null
git add src/generated/build-id.js src/character-runtime.html

if [[ ! -x scripts/capture-current-dashboard.sh ]]; then
  echo "Dashboard capture hook: scripts/capture-current-dashboard.sh is not executable" >&2
  exit 1
fi

echo "Dashboard capture hook: frontend change detected; refreshing docs/current-dashboard.png"
"$ROOT_DIR/scripts/hermes-display" restart >/dev/null 2>&1 || true
sleep 4
scripts/capture-current-dashboard.sh --repo-only
git add docs/current-dashboard.png
