#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || realpath -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PROJECT="${HERMES_PERSONAL_DISPLAY_PROJECT:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"
ENV_FILE="${HERMES_DISPLAY_ENV_FILE:-$HOME/.config/hermes-personal-display.env}"
if [[ -r "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi
DISPLAY_NUM="${HERMES_DISPLAY_NUM:-:0}"
SYSTEM_SERVICE="${HERMES_DISPLAY_SYSTEM_SERVICE:-hermes-personal-display-minix.service}"
PREVIEW_SERVICE="${HERMES_DISPLAY_PREVIEW_SERVICE:-hermes-personal-display-preview.service}"
STATE_URL="${HERMES_DISPLAY_STATE_URL:-http://127.0.0.1:8770/api/hermes-state}"
RUNTIME_PATH="/src/character-runtime.html"
LOG_DIR="${HERMES_DISPLAY_LOG_DIR:-$HOME/.hermes/logs}"
LOG_FILE="$LOG_DIR/hermes-display.log"
DISPLAY_OUTPUT="${HERMES_DISPLAY_OUTPUT:-${PERSONAL_DISPLAY_OUTPUT:-}}"
AUDIO_SINK="${HERMES_DISPLAY_AUDIO_SINK:-${PERSONAL_DISPLAY_AUDIO_SINK:-}}"
AUDIO_VOLUME="${HERMES_DISPLAY_AUDIO_VOLUME:-${PERSONAL_DISPLAY_AUDIO_VOLUME:-90%}}"
XAUTH_GLOB="/tmp/serverauth.*"
mkdir -p "$LOG_DIR"

log() {
  printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$LOG_FILE" >&2
}

usage() {
  cat <<'EOF'
Usage: hermes-display [verify|fix|restart|status|screenshot|build-id|url]

Commands:
  verify      Check preview API, system service, live Chromium URL/build, display layout, thermal policy, and audio.
  fix         Repair the display path: restart preview if needed, restart the real system kiosk, then verify.
  restart     Force a full preview + system kiosk restart, then verify.
  status      Show service, process, URL, display, thermal-policy, and audio status.
  screenshot  Capture the kiosk display screenshot under docs/review-artifacts/.
  build-id    Print the expected display build id from src/generated/build-id.js.
  url         Print the canonical kiosk URL using the current build id.

This command is intentionally service-aware. It uses hermes-personal-display-minix.service
instead of spawning an unmanaged nohup/startx chain, so one command path owns the physical kiosk.
EOF
}

build_id() {
  python3 - "$PROJECT/src/generated/build-id.js" <<'PY'
import re, sys
path = sys.argv[1]
text = open(path, encoding='utf-8').read()
match = re.search(r"window\.__HERMES_DISPLAY_BUILD_ID\s*=\s*['\"]([^'\"]+)['\"]", text)
if not match:
    raise SystemExit(f"could not find __HERMES_DISPLAY_BUILD_ID in {path}; run npm run generate:build-id")
print(match.group(1))
PY
}

canonical_url() {
  local build
  build="$(build_id)"
  printf 'http://127.0.0.1:8770%s?kiosk=1&orientation=landscape&augury=1&v=%s\n' "$RUNTIME_PATH" "$build"
}

latest_xauth() {
  ls -t $XAUTH_GLOB 2>/dev/null | head -1 || true
}

xrun() {
  local auth
  auth="$(latest_xauth)"
  if [[ -n "$auth" ]]; then
    DISPLAY="$DISPLAY_NUM" XAUTHORITY="$auth" "$@"
  else
    DISPLAY="$DISPLAY_NUM" "$@"
  fi
}

live_chromium_line() {
  pgrep -af '[c]hromium.*character-runtime\.html.*kiosk=1' || true
}

canonical_url_status() {
  local live="$1" build="$2"
  if [[ -z "$live" ]]; then
    echo "fail: no live Chromium kiosk process"
    return 1
  fi
  LIVE_CHROMIUM="$live" python3 - "$RUNTIME_PATH" "$build" <<'PY'
import os
import re
import sys
from urllib.parse import parse_qs, unquote, urlsplit

runtime_path, build = sys.argv[1], sys.argv[2]
live = os.environ.get("LIVE_CHROMIUM", "").splitlines()
expected = {
    "kiosk": "1",
    "orientation": "landscape",
    "augury": "1",
    "v": build,
}
seen = []
for line in live:
    for raw in re.findall(r"https?://[^\s'\"]+", line):
        url = unquote(raw)
        parts = urlsplit(url)
        path = parts.path
        query = parse_qs(parts.query, keep_blank_values=True)
        params_ok = all(query.get(k) == [v] for k, v in expected.items())
        if path == runtime_path and params_ok:
            print("ok: canonical operator URL")
            raise SystemExit(0)
        if "character-runtime" in path:
            seen.append(f"{path}?{parts.query}")
if seen:
    print("fail: expected exact canonical operator URL; saw " + " | ".join(seen[:3]))
else:
    print(f"fail: expected {runtime_path}?kiosk=1&orientation=landscape&augury=1&v={build}")
raise SystemExit(1)
PY
}

state_api_ok() {
  python3 - "$STATE_URL" <<'PY'
import json, sys, urllib.request
url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=2.5) as res:
        data = json.loads(res.read().decode('utf-8', 'replace'))
    print(data.get('freshness', {}).get('tier') or data.get('gateway', {}).get('status') or 'ok')
except Exception as exc:
    print(f"state API failed: {type(exc).__name__}: {exc}")
    raise SystemExit(1)
PY
}

detect_display_output() {
  if [[ -n "$DISPLAY_OUTPUT" ]]; then
    printf '%s\n' "$DISPLAY_OUTPUT"
    return 0
  fi
  xrun xrandr --query 2>/dev/null | awk '/ connected/ {print $1; exit}'
}

check_display_output() {
  local output line expected_mode expected_rotate expected_pos
  output="$(detect_display_output)"
  expected_mode="${HERMES_DISPLAY_OUTPUT_MODE:-${PERSONAL_DISPLAY_OUTPUT_MODE:-1920x1280}}"
  expected_rotate="${HERMES_DISPLAY_OUTPUT_ROTATE:-${PERSONAL_DISPLAY_OUTPUT_ROTATE:-inverted}}"
  expected_pos="${HERMES_DISPLAY_OUTPUT_POS:-${PERSONAL_DISPLAY_OUTPUT_POS:-0x0}}"
  local geometry_pos="${expected_pos/x/+}"
  line="$(xrun xrandr --query 2>/dev/null | grep "^${output} connected" || true)"
  if [[ -z "$line" ]]; then
    echo "${output:-display output} not connected"
    return 1
  fi
  echo "$line"
  [[ "$line" == *"primary"* && "$line" == *"${expected_mode}+${geometry_pos}"* && "$line" == *"$expected_rotate"* ]]
}

check_dp2() {
  check_display_output
}

detect_audio_sink() {
  if [[ -n "$AUDIO_SINK" ]]; then
    printf '%s\n' "$AUDIO_SINK"
    return 0
  fi
  pactl list short sinks 2>/dev/null | awk '/hdmi-stereo/ {print $2; exit} END {if (NR == 0) exit 1}' || pactl get-default-sink 2>/dev/null || true
}

check_thermal_policy() {
  local path="/sys/devices/system/cpu/intel_pstate/max_perf_pct" value expected
  expected="${HERMES_DISPLAY_MAX_PERF_PCT:-${PERSONAL_DISPLAY_MAX_PERF_PCT:-85}}"
  if [[ ! -r "$path" ]]; then
    echo "WARN thermal policy: $path unavailable"
    return 0
  fi
  value="$(tr -d '[:space:]' < "$path")"
  if [[ "$value" =~ ^[0-9]+$ && "$value" -le "$expected" ]]; then
    echo "max_perf_pct=$value (target <= $expected)"
    return 0
  fi
  echo "WARN thermal policy inactive: max_perf_pct=$value target<=$expected"
  return 0
}

check_audio() {
  if ! command -v pactl >/dev/null 2>&1; then
    echo "pactl unavailable"
    return 1
  fi
  local default mute volume sinks desired_pct sink_name
  sink_name="$(detect_audio_sink)"
  sinks="$(pactl list short sinks 2>/dev/null || true)"
  default="$(pactl get-default-sink 2>/dev/null || true)"
  mute="$(pactl get-sink-mute "${default:-@DEFAULT_SINK@}" 2>/dev/null || true)"
  volume="$(pactl get-sink-volume "${default:-@DEFAULT_SINK@}" 2>/dev/null | head -1 || true)"
  desired_pct="${AUDIO_VOLUME%%%}"
  echo "default=${default:-unknown} mute=${mute:-unknown} volume=${volume:-unknown} desired=${desired_pct}%"
  [[ -n "$sink_name" && "$sinks" == *"$sink_name"* && "$default" == "$sink_name" && "$mute" == *"no"* && "$volume" == *" ${desired_pct}%"* ]]
}

repair_audio_access() {
  # If PipeWire falls back to auto_null while ALSA still exposes /dev/snd,
  # restore user access to the current sound nodes and restart the user stack.
  if [[ -d /dev/snd ]] && command -v sudo >/dev/null 2>&1; then
    sudo -n setfacl -m "u:$(id -un):rw" /dev/snd/* >/dev/null 2>&1 || true
  fi
}

configure_audio() {
  if ! command -v pactl >/dev/null 2>&1; then
    log "pactl unavailable; skipping audio routing"
    return 0
  fi
  local sink target
  target="$(detect_audio_sink)"
  sink="$(pactl list short sinks 2>/dev/null | awk -v target="$target" '$2 == target {print $2; exit}' || true)"
  if [[ -z "$sink" ]]; then
    repair_audio_access
    systemctl --user restart wireplumber pipewire-pulse pipewire >/dev/null 2>&1 || true
    sleep 2
    target="$(detect_audio_sink)"
    sink="$(pactl list short sinks 2>/dev/null | awk -v target="$target" '$2 == target {print $2; exit}' || true)"
  fi
  if [[ -n "$sink" ]]; then
    pactl set-default-sink "$sink" >/dev/null 2>&1 || true
    pactl set-sink-mute "$sink" 0 >/dev/null 2>&1 || true
    pactl set-sink-volume "$sink" "$AUDIO_VOLUME" >/dev/null 2>&1 || true
    log "Audio configured: $sink volume=$AUDIO_VOLUME"
  else
    log "Audio HDMI sink unavailable after repair attempt"
  fi
}

status_kiosk() {
  local build live
  build="$(build_id)"
  echo "Project: $PROJECT"
  echo "Expected build: $build"
  echo "Canonical URL: $(canonical_url)"
  echo "System service: $SYSTEM_SERVICE $(systemctl is-active "$SYSTEM_SERVICE" 2>/dev/null || true)"
  echo "Preview service: $PREVIEW_SERVICE $(systemctl --user is-active "$PREVIEW_SERVICE" 2>/dev/null || true)"
  echo
  echo "Live Chromium:"
  live="$(live_chromium_line)"
  if [[ -n "$live" ]]; then
    printf '%s\n' "$live" | sed -n '1,8p'
  else
    echo "not running"
  fi
  echo
  echo "URL match:"
  canonical_url_status "$live" "$build" || true
  echo
  echo "Display output (${DISPLAY_OUTPUT:-auto}):"
  check_display_output || true
  echo
  echo "Thermal policy:"
  check_thermal_policy || true
  echo
  echo "Audio:"
  check_audio || true
}

verify_kiosk() {
  local ok=0 build live state display_status
  build="$(build_id)"
  echo "Expected build: $build"

  if systemctl --user is-active --quiet "$PREVIEW_SERVICE"; then
    echo "OK preview service active: $PREVIEW_SERVICE"
  else
    echo "FAIL preview service inactive: $PREVIEW_SERVICE"
    ok=1
  fi

  if systemctl is-active --quiet "$SYSTEM_SERVICE"; then
    echo "OK system kiosk active: $SYSTEM_SERVICE"
  else
    echo "FAIL system kiosk inactive: $SYSTEM_SERVICE"
    ok=1
  fi

  if state="$(state_api_ok 2>&1)"; then
    echo "OK state API: $state"
  else
    echo "FAIL state API: $state"
    ok=1
  fi

  live="$(live_chromium_line)"
  local url_status=0 url_message
  url_message="$(canonical_url_status "$live" "$build")" || url_status=$?
  if [[ "$url_status" -eq 0 ]]; then
    echo "OK live Chromium URL canonical: $url_message"
  else
    echo "FAIL live Chromium URL not canonical: $url_message"
    [[ -n "$live" ]] && printf '%s\n' "$live" | sed -n '1,4p' || echo "no live Chromium kiosk process"
    ok=1
  fi

  if display_status="$(check_display_output 2>&1)"; then
    echo "OK display layout: $display_status"
  else
    echo "FAIL display layout: $display_status"
    ok=1
  fi

  echo "Thermal policy: $(check_thermal_policy)"

  if audio="$(check_audio 2>&1)"; then
    echo "OK audio sink: $audio"
  else
    echo "FAIL audio sink: $audio"
    ok=1
  fi

  return "$ok"
}

wait_for_verified_display() {
  local i out
  for i in $(seq 1 60); do
    if out="$(verify_kiosk 2>&1)"; then
      printf '%s\n' "$out"
      return 0
    fi
    # X startup is not atomic: after systemd restarts startx, DP-2 can briefly appear at
    # the wrong position/rotation and Chromium may not have opened the app URL yet.
    sleep 1
  done
  printf '%s\n' "$out"
  return 1
}

fix_kiosk() {
  local force="${1:-}"
  log "Fixing Hermes physical display path"
  configure_audio

  if [[ "$force" == "--force" ]] || ! systemctl --user is-active --quiet "$PREVIEW_SERVICE" || ! state_api_ok >/dev/null 2>&1; then
    log "Restarting preview service: $PREVIEW_SERVICE"
    systemctl --user restart "$PREVIEW_SERVICE"
  fi

  log "Restarting physical kiosk service: $SYSTEM_SERVICE"
  sudo -n systemctl restart "$SYSTEM_SERVICE"

  if ! wait_for_verified_display; then
    log "Display did not verify cleanly after restart"
    status_kiosk >&2 || true
    return 1
  fi
}

screenshot_dp2() {
  local out_dir ts full crop
  if ! command -v scrot >/dev/null 2>&1; then
    echo "scrot is required for screenshots" >&2
    exit 1
  fi
  out_dir="$PROJECT/docs/review-artifacts"
  mkdir -p "$out_dir"
  ts="$(date +%Y%m%d-%H%M%S)"
  full="$out_dir/hermes-display-full-$ts.png"
  crop="$out_dir/hermes-display-${DISPLAY_OUTPUT:-display}-$ts.png"
  xrun scrot "$full"
  python3 - "$full" "$crop" <<'PY'
import sys
from PIL import Image
full, crop = sys.argv[1], sys.argv[2]
im = Image.open(full)
im.crop((0, 0, 1920, 1280)).save(crop)
print(crop)
PY
}

cmd="${1:-verify}"
case "$cmd" in
  verify) verify_kiosk ;;
  fix) fix_kiosk ;;
  restart) fix_kiosk --force ;;
  status) status_kiosk ;;
  screenshot) screenshot_dp2 ;;
  build-id) build_id ;;
  url) canonical_url ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
