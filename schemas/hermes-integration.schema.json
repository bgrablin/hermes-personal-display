{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Hermes integration inspection",
  "description": "Loopback operator endpoint only. Never included in family state. Strings are credential-redacted before bounding.",
  "type": "object",
  "required": [
    "schema_version",
    "sources",
    "coverage",
    "rpc",
    "provider_calls",
    "cron_incidents"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "coverage": {
      "enum": [
        "observed",
        "unavailable"
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "observed_at",
          "owner",
          "sessions",
          "fresh",
          "age_seconds"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "owner": {
            "type": "string"
          },
          "observed_at": {
            "type": "number"
          },
          "fresh": {
            "type": "boolean"
          },
          "age_seconds": {
            "type": "number"
          },
          "sessions": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "session_id",
                "status",
                "processes",
                "delegations"
              ],
              "properties": {
                "session_id": {
                  "type": "string"
                },
                "session_key": {
                  "type": "string",
                  "maxLength": 800
                },
                "profile": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "tools": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool_call_id",
                      "tool_name",
                      "status"
                    ],
                    "properties": {
                      "tool_call_id": { "type": "string", "maxLength": 800 },
                      "tool_name": { "type": "string", "maxLength": 800 },
                      "turn_id": { "type": ["string", "null"], "maxLength": 800 },
                      "status": { "type": "string", "maxLength": 32 },
                      "duration_ms": { "type": "integer", "minimum": 0 },
                      "observed_started_at": { "type": "number" },
                      "observed_finished_at": { "type": "number" },
                      "evidence": { "type": "string", "maxLength": 120 }
                    }
                  }
                },
                "processes": {
                  "type": "array",
                  "maxItems": 64
                },
                "delegations": {
                  "type": "array",
                  "maxItems": 64
                },
                "subagents": {
                  "type": "array",
                  "maxItems": 64
                },
                "tool_outcome": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "tool_name",
                    "message",
                    "observed_at"
                  ],
                  "properties": {
                    "status": {
                      "const": "unknown"
                    },
                    "tool_name": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "tool_call_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 800
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "observed_at": {
                      "type": "number"
                    }
                  }
                },
                "interruption": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "observed_at"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "invalidation_reason": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "platform": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "observed_at": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "rpc": {
      "type": "object",
      "required": [
        "sessions",
        "status"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "maxItems": 128
        },
        "status": {
          "type": "string"
        }
      }
    },
    "provider_calls": {
      "type": "array",
      "maxItems": 8
    },
    "cron_incidents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "open",
        "recent",
        "summary",
        "incidents"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "open": { "type": "integer", "minimum": 0 },
        "recent": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "maxLength": 72 },
        "profiles_checked": { "type": "integer", "minimum": 0 },
        "read_errors": { "type": "integer", "minimum": 0 },
        "profiles_truncated": { "type": "boolean" },
        "discovery_error": { "type": "boolean" },
        "incidents": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "job_id", "job", "profile", "state", "failure_type",
              "first_seen_at", "last_seen_at", "age_seconds", "recent", "error", "output_file"
            ],
            "properties": {
              "id": { "type": "string", "maxLength": 80 },
              "job_id": { "type": "string", "maxLength": 80 },
              "job": { "type": "string", "maxLength": 72 },
              "profile": { "type": "string", "maxLength": 64 },
              "state": { "enum": ["detected", "alerted"] },
              "failure_type": { "type": "string", "maxLength": 32 },
              "first_seen_at": { "type": "string", "maxLength": 48 },
              "last_seen_at": { "type": "string", "maxLength": 48 },
              "age_seconds": { "type": ["integer", "null"], "minimum": 0 },
              "recent": { "type": "boolean" },
              "error": { "type": "string", "maxLength": 240 },
              "output_file": { "type": "string", "maxLength": 180 }
            }
          }
        }
      }
    }
  }
}
