# Copy to ~/.config/hermes-personal-display.env and adjust after running:
#   <project-root>/scripts/detect-display-env.sh

PERSONAL_DISPLAY_URL=http://127.0.0.1:8770/src/character-runtime.html?kiosk=1&orientation=landscape&augury=1
# Set one of these after live hardware/session inspection.
# DISPLAY=:0
# WAYLAND_DISPLAY=wayland-0
# XAUTHORITY=/run/user/1000/gdm/Xauthority

# Optional browser override if auto-detection is wrong.
# PERSONAL_DISPLAY_CHROME=/usr/bin/chromium-browser

# MINIX SF10T target defaults. Native landscape is 1920x1280; portrait is 1280x1920.
PERSONAL_DISPLAY_WINDOW_SIZE=1920,1280
PERSONAL_DISPLAY_OUTPUT=DP-2
PERSONAL_DISPLAY_OUTPUT_MODE=1920x1280
PERSONAL_DISPLAY_OUTPUT_ROTATE=inverted
PERSONAL_DISPLAY_OUTPUT_POS=0x0
PERSONAL_DISPLAY_AUDIO_SINK=alsa_output.pci-0000_00_1f.3.hdmi-stereo
PERSONAL_DISPLAY_AUDIO_VOLUME=90%
# Optional Chromium flags, space-separated. Keep empty unless troubleshooting.
# PERSONAL_DISPLAY_CHROME_ARGS=--force-device-scale-factor=1
