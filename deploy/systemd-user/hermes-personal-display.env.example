# Copy to ~/.config/hermes-personal-display.env and adjust after running:
#   <project-root>/scripts/detect-display-env.sh

PERSONAL_DISPLAY_URL=http://127.0.0.1:8770/src/character-runtime.html?kiosk=1&orientation=landscape&augury=1
# Set one of these after live hardware/session inspection.
# DISPLAY=:0
# WAYLAND_DISPLAY=wayland-0
# XAUTHORITY=/run/user/1000/gdm/Xauthority

# Optional browser override if auto-detection is wrong.
# PERSONAL_DISPLAY_CHROME=/usr/bin/chromium-browser

# MINIX SF10T target defaults. Native landscape is 1920x1280; portrait is 1280x1920.
PERSONAL_DISPLAY_WINDOW_SIZE=1920,1280
# Optional terminal renderer. `herdr-monitor` replaces Chromium with Alacritty
# and an isolated tmux source containing one btop pane and one health pane. It
# does not attach to or resize an interactive Herdr workspace. Leave unset for
# the character-runtime Chromium kiosk.
# PERSONAL_DISPLAY_RENDERER=herdr-monitor
# PERSONAL_DISPLAY_MONITOR_POLL_SECONDS=1
# PERSONAL_DISPLAY_HEALTH_MONITOR=/path/to/read-only-health-monitor
# PERSONAL_DISPLAY_BTOP_CONFIG=/path/to/btop.conf
# PERSONAL_DISPLAY_SOURCE_TMUX_SOCKET=hermes-personal-display-source
# PERSONAL_DISPLAY_SOURCE_TMUX_SESSION=hermes-personal-display-source
PERSONAL_DISPLAY_OUTPUT=DP-2
PERSONAL_DISPLAY_OUTPUT_MODE=1920x1280
PERSONAL_DISPLAY_OUTPUT_ROTATE=inverted
PERSONAL_DISPLAY_OUTPUT_POS=0x0
PERSONAL_DISPLAY_AUDIO_SINK=alsa_output.pci-0000_00_1f.3.hdmi-stereo
PERSONAL_DISPLAY_AUDIO_VOLUME=90%
# Optional Chromium flags, space-separated. Keep empty unless troubleshooting.
# PERSONAL_DISPLAY_CHROME_ARGS=--force-device-scale-factor=1

# Optional confirmed GitHub Copilot AI-credit headroom. The account and plan are
# not secrets. Billing API authentication is loaded from Hermes' protected env
# or the existing `gh` CLI login; do not place tokens in this 0644 file.
# HERMES_DISPLAY_COPILOT_ACCOUNT=github-login
# HERMES_DISPLAY_COPILOT_PLAN=pro
# Use an explicit positive limit only to override an individual-plan allowance.
# Organization and enterprise billing endpoints are not supported by this collector.
# HERMES_DISPLAY_COPILOT_CREDIT_LIMIT=1500
