[Unit]
Description=Hermes NUC kiosk thermal policy (opt-in CPU max_perf_pct=80)
Documentation=man:cpupower(1)
ConditionPathExists=/sys/devices/system/cpu/intel_pstate/max_perf_pct
ConditionPathExists=/sys/devices/system/cpu/intel_pstate/no_turbo

[Service]
Type=oneshot
RemainAfterExit=yes
# Keep turbo available, but cap Intel p-state maximum performance to reduce kiosk thermals.
ExecStart=/usr/bin/bash -lc 'printf 0 > /sys/devices/system/cpu/intel_pstate/no_turbo; printf 80 > /sys/devices/system/cpu/intel_pstate/max_perf_pct'
# Rollback restores the stock local policy used before kiosk thermal capping.
ExecStop=/usr/bin/bash -lc 'printf 0 > /sys/devices/system/cpu/intel_pstate/no_turbo; printf 100 > /sys/devices/system/cpu/intel_pstate/max_perf_pct'

[Install]
WantedBy=multi-user.target
